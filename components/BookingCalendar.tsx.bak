### /Users/jeromesinaca/My Apps/CCRentals/./components/BookingCalendar.tsx
```
1: import React, { useState, useEffect } from 'react';
2: import { motion, AnimatePresence } from 'framer-motion';
3: 
4: interface BookingCalendarProps {
5:   onDateSelect?: (startDate: Date, endDate: Date) => void;
6:   blockedDates?: Date[];
7: }
8: 
9: const BookingCalendar: React.FC<BookingCalendarProps> = ({
10:   onDateSelect,
11:   blockedDates = []
12: }) => {
13:   const [currentMonth, setCurrentMonth] = useState(new Date());
14:   const [startDate, setStartDate] = useState<Date | null>(null);
15:   const [endDate, setEndDate] = useState<Date | null>(null);
16:   const [hoveredDate, setHoveredDate] = useState<Date | null>(null);
17:   const [focusedDate, setFocusedDate] = useState<number | null>(null);
18: 
19:   const monthNames = [
20:     'January', 'February', 'March', 'April', 'May', 'June',
21:     'July', 'August', 'September', 'October', 'November', 'December'
22:   ];
23: 
24:   const daysOfWeek = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
25: 
26:   const handleKeyDown = (date: Date, index: number, e: React.KeyboardEvent) => {
27:     const daysInMonth = getDaysInMonth(currentMonth);
28:     let newIndex = index;
29: 
30:     switch (e.key) {
31:       case 'ArrowLeft':
32:         newIndex = index - 1;
33:         break;
34:       case 'ArrowRight':
35:         newIndex = index + 1;
36:         break;
37:       case 'ArrowUp':
38:         newIndex = index - 7;
39:         break;
40:       case 'ArrowDown':
41:         newIndex = index + 7;
42:         break;
43:       case 'Home':
44:         newIndex = 0;
45:         break;
46:       case 'End':
47:         newIndex = daysInMonth.length - 1;
48:         break;
49:       case 'PageUp':
50:         e.preventDefault();
51:         prevMonth();
52:         return;
53:       case 'PageDown':
54:         e.preventDefault();
55:         nextMonth();
56:         return;
57:       default:
58:         return;
59:     }
60: 
61:     if (newIndex >= 0 && newIndex < daysInMonth.length && daysInMonth[newIndex]) {
62:       setFocusedDate(newIndex);
63:       const buttons = document.querySelectorAll('[role="gridcell"][tabindex="0"]');
64:       const targetButton = buttons[newIndex] as HTMLElement;
65:       targetButton?.focus();
66:     }
67:   };
68: 
69:   const getDaysInMonth = (date: Date) => {
70:     const year = date.getFullYear();
71:     const month = date.getMonth();
72:     const firstDay = new Date(year, month, 1);
73:     const lastDay = new Date(year, month + 1, 0);
74:     const daysInMonth = lastDay.getDate();
75:     const startingDayOfWeek = firstDay.getDay();
76: 
77:     const days: (Date | null)[] = [];
78: 
79:     for (let i = 0; i < startingDayOfWeek; i++) {
80:       days.push(null);
81:     }
82: 
83:     for (let day = 1; day <= daysInMonth; day++) {
84:       days.push(new Date(year, month, day));
85:     }
86: 
87:     return days;
88:   };
89: 
90:   const isSameDay = (date1: Date | null, date2: Date | null) => {
91:     if (!date1 || !date2) return false;
92:     return (
93:       date1.getFullYear() === date2.getFullYear() &&
94:       date1.getMonth() === date2.getMonth() &&
95:       date1.getDate() === date2.getDate()
96:     );
97:   };
98: 
99:   const isDateBlocked = (date: Date) => {
100:     return blockedDates.some(blocked => isSameDay(blocked, date));
101:   };
102: 
103:   const isDateInPast = (date: Date) => {
104:     const today = new Date();
105:     today.setHours(0, 0, 0, 0);
106:     return date < today;
107:   };
108: 
109:   const isDateInRange = (date: Date) => {
110:     if (!startDate || !endDate) {
111:       if (startDate && hoveredDate && !isSameDay(startDate, date)) {
112:         const rangeStart = startDate < hoveredDate ? startDate : hoveredDate;
113:         const rangeEnd = startDate < hoveredDate ? hoveredDate : startDate;
114:         return date > rangeStart && date < rangeEnd;
115:       }
116:       return false;
117:     }
118:     return date > startDate && date < endDate;
119:   };
120: 
121:   const handleDateClick = (date: Date) => {
122:     if (isDateBlocked(date) || isDateInPast(date)) return;
123: 
124:     if (!startDate || (startDate && endDate)) {
125:       setStartDate(date);
126:       setEndDate(null);
127:     } else {
128:       if (date < startDate) {
129:         setEndDate(startDate);
130:         setStartDate(date);
131:       } else {
132:         setEndDate(date);
133:       }
134: 
135:       if (onDateSelect) {
136:         const finalStart = date < startDate ? date : startDate;
137:         const finalEnd = date < startDate ? startDate : date;
138:         onDateSelect(finalStart, finalEnd);
139:       }
140:     }
141:   };
142: 
143:   const nextMonth = () => {
144:     setCurrentMonth(new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1));
145:     setFocusedDate(0);
146:   };
147: 
148:   const prevMonth = () => {
149:     setCurrentMonth(new Date(currentMonth.getFullYear(), currentMonth.getMonth() - 1));
150:     setFocusedDate(0);
151:   };
152: 
153:   const resetSelection = () => {
154:     setStartDate(null);
155:     setEndDate(null);
156:   };
157: 
158:   const getDaysBetween = () => {
159:     if (!startDate || !endDate) return 0;
160:     const diff = Math.abs(endDate.getTime() - startDate.getTime());
161:     return Math.ceil(diff / (1000 * 60 * 60 * 24)) + 1;
162:   };
163: 
164:   const days = getDaysInMonth(currentMonth);
165:   const daysBetween = getDaysBetween();
166: 
167:   const weeks: (Date | null)[][] = [];
168:   for (let i = 0; i < days.length; i += 7) {
169:     weeks.push(days.slice(i, i + 7));
170:   }
171: 
172:   return (
173:     <div className="bg-card border border-border rounded-3xl p-6 sm:p-8 shadow-xl">
174:       <div className="mb-6">
175:         <h3 className="text-2xl sm:text-3xl font-bold text-foreground mb-2">
176:           Select Rental Dates
177:         </h3>
178:         <p className="text-muted-foreground text-sm">
179:           Choose your start and end dates
180:         </p>
181:       </div>
182: 
183:       <div className="flex items-center justify-between mb-6" role="group" aria-label="Month navigation">
184:         <button
185:           type="button"
186:           onClick={prevMonth}
187:           className="p-2 hover:bg-secondary rounded-lg transition-colors"
188:           aria-label="Previous month"
189:         >
190:           <svg className="w-5 h-5 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
191:             <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" />
192:           </svg>
193:         </button>
194:         <div className="text-lg font-bold text-foreground" aria-live="polite" aria-atomic="true">
195:           {monthNames[currentMonth.getMonth()]} {currentMonth.getFullYear()}
196:         </div>
197:         <button
198:           type="button"
199:           onClick={nextMonth}
200:           className="p-2 hover:bg-secondary rounded-lg transition-colors"
201:           aria-label="Next month"
202:         >
203:           <svg className="w-5 h-5 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
204:             <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5l7 7-7 7" />
205:           </svg>
206:         </button>
207:       </div>
208: 
209:       <div
210:         role="grid"
211:         aria-label="Calendar"
212:         className="space-y-2"
213:       >
214:         <div role="row" className="grid grid-cols-7 gap-2">
215:           {daysOfWeek.map((day) => (
216:             <div key={day} role="columnheader" className="text-center text-xs font-bold text-muted-foreground py-2">
217:               {day}
218:             </div>
219:           ))}
220:         </div>
221: 
222:         {weeks.map((week, weekIndex) => (
223:           <div role="row" key={weekIndex} className="grid grid-cols-7 gap-2">
224:             {week.map((date, dayIndex) => {
225:               const globalIndex = weekIndex * 7 + dayIndex;
226:               if (!date) {
227:                 return <div key={globalIndex} role="gridcell" aria-hidden="true" />;
228:               }
229: 
230:               const isStart = isSameDay(date, startDate);
231:               const isEnd = isSameDay(date, endDate);
232:               const isInRange = isDateInRange(date);
233:               const isBlocked = isDateBlocked(date);
234:               const isPast = isDateInPast(date);
235:               const isDisabled = isBlocked || isPast;
236: 
237:               const isSelected = isStart || isEnd;
238:               const availabilityLabel = isDisabled
239:                 ? (isBlocked ? 'unavailable' : 'past date')
240:                 : 'available';
241:               
242:               return (
243:                 <motion.button
244:                   type="button"
245:                   key={date.toISOString()}
246:                   role="gridcell"
247:                   onClick={() => handleDateClick(date)}
248:                   onMouseEnter={() => setHoveredDate(date)}
249:                   onMouseLeave={() => setHoveredDate(null)}
250:                   onKeyDown={(e) => handleKeyDown(date, globalIndex, e)}
251:                   disabled={isDisabled}
252:                   tabIndex={focusedDate === globalIndex ? 0 : -1}
253:                   whileHover={!isDisabled ? { scale: 1.1 } : {}}
254:                   whileTap={!isDisabled ? { scale: 0.95 } : {}}
255:                   aria-label={monthNames[date.getMonth()] + ' ' + date.getDate() + ', ' + date.getFullYear() + ', ' + availabilityLabel}
256:                   aria-selected={isSelected}
257:                   aria-disabled={isDisabled}
258:                   className={aspect-square rounded-lg flex items-center justify-center text-sm font-medium transition-all + 
259:                     (isStart || isEnd
260:                       ? ' bg-primary text-primary-foreground shadow-lg shadow-primary/25 z-10'
261:                       : isInRange
262:                       ? ' bg-primary/20 text-foreground'
263:                       : isDisabled
264:                       ? ' text-muted-foreground/30 cursor-not-allowed'
265:                       : ' hover:bg-secondary text-foreground'
266:                     )}
267:                 >
268:                   {date.getDate()}
269:                 </motion.button>
270:               );
271:             })}
272:           </div>
273:         ))}
274:       </div>
275: 
276:       <AnimatePresence>
277:         {(startDate || endDate) && (
278:           <motion.div
279:             initial={{ opacity: 0, height: 0 }}
280:             animate={{ opacity: 1, height: 'auto' }}
281:             exit={{ opacity: 0, height: 0 }}
282:             className="mt-6 pt-6 border-t border-border"
283:             role="region"
284:             aria-label="Selected date range"
285:           >
286:             <div className="bg-primary/10 rounded-xl p-4 border border-primary/20">
287:               <div className="grid grid-cols-2 gap-4 mb-3">
288:                 <div>
289:                   <div className="text-xs text-muted-foreground mb-1">Start Date</div>
290:                   <div className="font-bold text-foreground">
291:                     {startDate?.toLocaleDateString('en-US', {
292:                       month: 'short',
293:                       day: 'numeric',
294:                       year: 'numeric'
295:                     })}
296:                   </div>
297:                 </div>
298:                 {endDate && (
299:                   <div>
300:                     <div className="text-xs text-muted-foreground mb-1">End Date</div>
301:                     <div className="font-bold text-foreground">
302:                       {endDate?.toLocaleDateString('en-US', {
303:                         month: 'short',
304:                         day: 'numeric',
305:                         year: 'numeric'
306:                       })}
307:                     </div>
308:                   </div>
309:                 )}
310:               </div>
311:               {daysBetween > 0 && (
312:                 <div className="text-center pt-3 border-t border-primary/20">
313:                   <span className="text-2xl font-bold text-primary">{daysBetween}</span>
314:                   <span className="text-sm text-muted-foreground ml-2">
315:                     {daysBetween === 1 ? 'day' : 'days'}
316:                   </span>
317:                 </div>
318:               )}
319:             </div>
320: 
321:             <button
322:               type="button"
323:               onClick={resetSelection}
324:               className="w-full mt-4 px-4 py-2 text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-secondary rounded-lg transition-colors"
325:             >
326:               Clear Selection
327:             </button>
328:           </motion.div>
329:         )}
330:       </AnimatePresence>
331: 
332:       <div className="mt-6 pt-6 border-t border-border" role="region" aria-label="Calendar legend">
333:         <div className="flex flex-wrap gap-4 text-xs">
334:           <div className="flex items-center gap-2">
335:             <div className="w-4 h-4 rounded bg-primary" aria-hidden="true" />
336:             <span className="text-muted-foreground">Selected</span>
337:           </div>
338:           <div className="flex items-center gap-2">
339:             <div className="w-4 h-4 rounded bg-primary/20" aria-hidden="true" />
340:             <span className="text-muted-foreground">In Range</span>
341:           </div>
342:           <div className="flex items-center gap-2">
343:             <div className="w-4 h-4 rounded bg-muted-foreground/10" aria-hidden="true" />
344:             <span className="text-muted-foreground">Unavailable</span>
345:           </div>
346:         </div>
347:       </div>
348:     </div>
349:   );
350: };
351: 
352: export default BookingCalendar;
```
