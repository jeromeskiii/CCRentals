# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration (Required for production)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini AI API Key (Required for AI features)
GEMINI_API_KEY=your-gemini-api-key

# Email Configuration (Required for quote form email notifications)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The business email address to receive quote notifications
BUSINESS_EMAIL=info@yourbusiness.com

# Notes:
# - Never commit .env.local to version control
# - Add .env.local to .gitignore
# - Use different keys for development and production environments
# - Rotate API keys regularly
# - Store production secrets in CI/CD environment variables (Vercel, GitHub Actions, etc.)
